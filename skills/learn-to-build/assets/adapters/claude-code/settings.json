{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR/.ltb/guard.py\" || exit 0; exec python3 \"$CLAUDE_PROJECT_DIR/.ltb/guard.py\""
          }
        ]
      }
    ]
  }
}
