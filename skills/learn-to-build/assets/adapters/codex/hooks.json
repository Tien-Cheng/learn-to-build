{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"$(git rev-parse --show-toplevel)/{PROJECT_PATH}.ltb/guard.py\"; test -f \"$g\" || exit 0; exec python3 \"$g\"",
            "timeout": 30,
            "statusMessage": "learn-to-build: checking Assistance mode"
          }
        ]
      }
    ]
  }
}
