                                                 "paths": args.paths, "note": args.note or ""})
        print("Logged agent-written code for Stage %s." % args.stage.zfill(2))
    elif args.kind == "summary":
        if not args.stage:
            raise UsageError("log summary needs --stage")
        entry = dict(stage_summary(root, args.stage.zfill(2)), ts=timestamp(), kind="summary",
