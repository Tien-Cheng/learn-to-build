def cmd_dial(root, args):
    if args.name not in DIALS:
        raise UsageError("dial must be one of %s" % ", ".join(DIALS))
    value = int(args.value)
    if not 1 <= value <= 5:
        raise UsageError("dial values run from 1 to 5")
    path = Path(root) / ".ltb" / "config"
    text = path.read_text()
    current = Config(path).dials.get(args.name)
    pattern = re.compile(r"^(%s\s*=\s*)\S+" % args.name, re.M)
    section = text.find("[dials]")
    if section < 0:
        text = text.rstrip("\n") + "\n\n[dials]\n%s = %d\n" % (args.name, value)
    elif pattern.search(text, section):
        m = pattern.search(text, section)
        text = text[:m.start()] + m.group(1) + str(value) + text[m.end():]
    else:
        insert = text.index("\n", section) + 1
        text = text[:insert] + "%s = %d\n" % (args.name, value) + text[insert:]
    path.write_text(text)
    append_jsonl(Path(root) / ".ltb" / "log" / "dials.jsonl", {
        "ts": timestamp(), "dial": args.name, "from": int(current) if current else None, "to": value,
        "evidence": args.evidence or "",
    })
    print("Dial %s: %s -> %d" % (args.name, current or "unset", value))
    return OK


# ---------------------------------------------------------------- assistance


def mode_for(config, number):
    return config.assist.get(number, config.assist_default)


def current_stage(root):
    stages = discover(root)
    return list(stages)[-1] if stages else None


def set_ini_value(text, section, key, value):
    """Set key = value in [section] of an INI text, keeping everything else as written."""
    header = re.search(r"^\[%s\]\s*$" % re.escape(section), text, re.M)
    if not header:
        return text.rstrip("\n") + "\n\n[%s]\n%s = %s\n" % (section, key, value)
    nxt = re.search(r"^\[", text[header.end():], re.M)
    end = header.end() + nxt.start() if nxt else len(text)
    body = text[header.end():end]
    line = re.compile(r"^%s\s*=.*$" % re.escape(key), re.M)
    if line.search(body):
        body = line.sub("%s = %s" % (key, value), body, count=1)
    else:
        body = body.rstrip("\n") + "\n%s = %s\n" % (key, value)
        if nxt:
            body += "\n"
    return text[:header.end()] + body + text[end:]


def cmd_assist(root, args):
    path = Path(root) / ".ltb" / "config"
    config = Config(path)
    if not args.mode:
        number = current_stage(root)
        print("Default: %s" % config.assist_default)
        for n, m in sorted(config.assist.items()):
            print("Stage %s: %s" % (n, m))
        if config.pair_paths:
            print("Pair paths: %s" % " ".join(config.pair_paths))
        if number:
            print("Current Stage %s: %s" % (number, mode_for(config, number)))
        return OK
    if args.mode not in MODES:
        raise UsageError("mode must be one of %s" % ", ".join(MODES))
    key = "default" if args.default else (args.stage or current_stage(root) or "").zfill(2)
    if key == "00":
        raise UsageError("no Stage released yet; use --default")
    text = set_ini_value(path.read_text(), "assist", key, args.mode)
    if args.paths is not None:
        text = set_ini_value(text, "assist", "pair_paths", " ".join(args.paths))
    path.write_text(text)
    append_jsonl(Path(root) / ".ltb" / "log" / "assist.jsonl",
                 {"ts": timestamp(), "event": "mode", "stage": key, "mode": args.mode, "paths": args.paths or []})
    print("Assistance mode for %s: %s" % ("the Project" if key == "default" else "Stage " + key, args.mode))
    return OK


# ---------------------------------------------------------------- checksums


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(65536), b""):
            h.update(block)
    return h.hexdigest()


def harness_globs(root):
    """Extra Harness files listed in .ltb/config [harness] files (e.g. Skeleton unit tests)."""
    parser = configparser.ConfigParser(inline_comment_prefixes=(";", "#"))
    parser.read(str(Path(root) / ".ltb" / "config"))
    return parser.get("harness", "files", fallback="").split()


def harness_paths(root):
    """Harness files the checksums cover, relative to root."""
    root = Path(root)
    paths = [p for p in HARNESS_FIXED if (root / p).is_file()]
    for pattern in harness_globs(root):
        paths += [str(p.relative_to(root)) for p in sorted(root.glob(pattern)) if p.is_file()]
    tests_dir = root / "tests"
    if tests_dir.is_dir():
        paths += ["tests/" + p.name for p in sorted(tests_dir.iterdir()) if STAGE_FILE.match(p.name)]
    hidden_dir = root / ".ltb" / "hidden"
    if hidden_dir.is_dir():
        paths += [".ltb/hidden/" + p.name for p in sorted(hidden_dir.iterdir()) if STAGE_FILE.match(p.name)]
    stages_dir = root / ".ltb" / "stages"
    if stages_dir.is_dir():
        paths += [str(p.relative_to(root)) for p in sorted(stages_dir.glob("*/check.json"))]
    return sorted(set(paths))


def read_checksums(root):
    path = Path(root) / ".ltb" / "checksums"
    if not path.is_file():
        return None
    recorded = {}
    for line in path.read_text().splitlines():
        if line.strip():
            digest, rel = line.split(None, 1)
            recorded[rel.strip()] = digest
    return recorded


def write_checksums(root):
    root = Path(root)
    lines = ["%s  %s" % (sha256(root / rel), rel) for rel in harness_paths(root)]
    (root / ".ltb").mkdir(exist_ok=True)
    (root / ".ltb" / "checksums").write_text("\n".join(lines) + "\n")
    return lines


def harness_problems(root):
    """[(path, problem)] where problem is changed | missing | unreleased."""
    root = Path(root)
    recorded = read_checksums(root)
    if recorded is None:
        return [(".ltb/checksums", "missing")]
    problems = []
    for rel, digest in sorted(recorded.items()):
        if not (root / rel).is_file():
            problems.append((rel, "missing"))
        elif sha256(root / rel) != digest:
            problems.append((rel, "changed"))
    for rel in harness_paths(root):
        if rel not in recorded:
            problems.append((rel, "unreleased"))
    return problems


def describe_problems(problems):
    lines = ["The Harness changed, so ltb will not grade. Harness files are written only by"
             " `learn-to-build next`; Solution code is everything else."]
    for rel, kind in problems:
        lines.append("  %-10s %s" % (kind, rel))
    restore = [rel for rel, kind in problems if kind in ("changed", "missing")]
    extra = [rel for rel, kind in problems if kind == "unreleased"]
    if restore:
        lines.append("Restore with:  git checkout -- " + " ".join(shlex.quote(r) for r in restore))
    if extra:
        lines.append("Remove files not released by next:  rm " + " ".join(shlex.quote(r) for r in extra))
    return "\n".join(lines)


def verify_or_raise(root):
    problems = harness_problems(root)
    if problems:
        raise HarnessChanged(describe_problems(problems))


def cmd_verify(root, args):
    verify_or_raise(root)
    print("Harness ok (%d files)." % len(read_checksums(root)))
    return OK


# ---------------------------------------------------------------- seal

STAGED_FILES = {"public.py", "primer.md", "hidden.py", "check.src.json", "skeleton.md", "unit", "unit.json"}


def seal(root, allow_changed=()):
    """Release staged Stages and re-record checksums. Returns a summary dict."""
    root = Path(root)
    allow = {str(Path(p)) for p in allow_changed}
    if read_checksums(root) is not None:
        blocking = [(rel, kind) for rel, kind in harness_problems(root) if rel not in allow]
        if blocking:
            raise HarnessChanged(describe_problems(blocking))
    problems = []
    plans = []
    released_numbers = {m.group(1) for m in (STAGE_FILE.match(p.name) for p in (root / "tests").glob("stage_*.py")) if m}
    for number, slug, d in staged_dirs(root):
        files = {p.name for p in d.iterdir()}
        unknown = files - STAGED_FILES
        if unknown:
            problems.append("%s: unsupported staged files: %s" % (d.name, ", ".join(sorted(unknown))))
        if "public.py" not in files or "primer.md" not in files:
            problems.append("%s: needs public.py and primer.md" % d.name)
            continue
        if number in released_numbers:
            problems.append("%s: Stage %s is already released" % (d.name, number))
        problems += lint_stage_source((d / "public.py").read_text(), "%s/public.py" % d.name)
        if "hidden.py" in files:
            problems += lint_stage_source((d / "hidden.py").read_text(), "%s/hidden.py" % d.name)
        check = None
        if "check.src.json" in files:
            try:
                check = seal_check(json.loads((d / "check.src.json").read_text()))
            except (ValueError, UsageError) as exc:
                problems.append("%s/check.src.json: %s" % (d.name, exc))
        if ("unit" in files) != ("unit.json" in files):
            problems.append("%s: Skeleton unit tests need both unit/ and unit.json" % d.name)
        elif "unit.json" in files:
            try:
                unit = json.loads((d / "unit.json").read_text())
                if not unit.get("command"):
                    raise ValueError("unit.json needs a command")
            except ValueError as exc:
                problems.append("%s/unit.json: %s" % (d.name, exc))
        plans.append((number, slug, d, check))
    for rel in allow:
        if STAGE_FILE.match(Path(rel).name) and (root / rel).is_file():
            problems += lint_stage_source((root / rel).read_text(), rel)
    if problems:
        raise UsageError("cannot seal:\n  " + "\n  ".join(problems))
    released = []
    for number, slug, d, check in plans:
        (root / "tests").mkdir(exist_ok=True)
        shutil.move(str(d / "public.py"), str(root / "tests" / ("stage_%s_%s.py" % (number, slug.replace("-", "_")))))
        stage_dir = root / ".ltb" / "stages" / ("%s-%s" % (number, slug))
        stage_dir.mkdir(parents=True, exist_ok=True)
        for name in ("primer.md", "skeleton.md"):
            if (d / name).is_file():
                shutil.move(str(d / name), str(stage_dir / name))
        if (d / "hidden.py").is_file():
            target = root / ".ltb" / "hidden" / ("stage_%s_%s.py" % (number, slug.replace("-", "_")))
            target.parent.mkdir(parents=True, exist_ok=True)
            source = (d / "hidden.py").read_text()
            target.write_text(source if source.startswith(HIDDEN_BANNER) else HIDDEN_BANNER + source)
            (d / "hidden.py").unlink()
        if check is not None:
            (stage_dir / "check.json").write_text(json.dumps(check, indent=1, sort_keys=True) + "\n")
            (d / "check.src.json").unlink()
        if (d / "unit.json").is_file():
            install_unit_tests(root, d)
        d.rmdir()
        released.append(number)
    lines = write_checksums(root)
    entry = {"ts": timestamp(), "stages": released, "allow_changed": sorted(allow), "files": len(lines)}
    append_jsonl(root / ".ltb" / "log" / "seals.jsonl", entry)
    return entry


def install_unit_tests(root, staged):
    """Move staged Skeleton unit tests (unit/ mirrors Project paths) into place and register them."""
    unit_dir = staged / "unit"
    placed = []
    for src in sorted(p for p in unit_dir.rglob("*") if p.is_file()):
        rel = src.relative_to(unit_dir)
        dest = root / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(src), str(dest))
        placed.append(str(rel))
    shutil.rmtree(str(unit_dir))
    command = json.loads((staged / "unit.json").read_text())["command"]
    (staged / "unit.json").unlink()
    path = root / ".ltb" / "config"
    files = sorted(set(harness_globs(root)) | set(placed))
    text = set_ini_value(path.read_text(), "harness", "files", " ".join(files))
    text = set_ini_value(text, "commands", "unit", command)
    path.write_text(text)
    return placed


def cmd_seal(root, args):
    entry = seal(root, args.allow_changed or ())
    if entry["stages"]:
        print("Released Stage(s) %s; checksums cover %d files." % (", ".join(entry["stages"]), entry["files"]))
    else:
        print("Checksums recorded for %d files." % entry["files"])
    return OK


# ---------------------------------------------------------------- check


def cmd_check(root, args):
    root = Path(root)
    number = args.stage.zfill(2) if args.stage else None
    if number is None:
        numbers = sorted(p.parent.name[:2] for p in (root / ".ltb" / "stages").glob("*/check.json"))
        if not numbers:
            raise UsageError("no Concept checks released")
        number = numbers[-1]
    path = check_file(root, number)
    if not path:
        raise UsageError("Stage %s has no Concept check" % number)
    questions = json.loads(path.read_text())["questions"]
    if args.question:
        questions = [q for q in questions if q["id"] == args.question]
        if not questions:
            raise UsageError("no question %s in Stage %s" % (args.question, number))
    print("Concept check, Stage %s: predict, then see. A miss only points you back to the Primer.\n" % number)
    right = 0
    for q in questions:
        print("[%s] %s" % (q["id"], q["prompt"]))
        for choice in q.get("choices", []):
            print("    " + choice)
        if args.answer is not None:
            answer = args.answer
            print("> %s" % answer)
        else:
            try:
                answer = input("> ")
            except EOFError:
                raise UsageError("no answer given; pass --question ID --answer TEXT")
        correct = hash_answer(q["salt"], q["kind"], answer) in q["answers"]
        right += correct
        append_jsonl(root / ".ltb" / "log" / "checks.jsonl",
                     {"ts": timestamp(), "stage": number, "q": q["id"], "answer": answer, "correct": correct})
        print("    correct\n" if correct else "    not quite: revisit %s\n" % q["on_miss"])
    print("%d/%d correct. Stage %s's tests are unlocked." % (right, len(questions), number))
    return OK


# ---------------------------------------------------------------- drills


def drills_path(root):
    return Path(root) / ".ltb" / "log" / "drills.json"


def read_drills(root):
    path = drills_path(root)
    if path.is_file():
        return json.loads(path.read_text())
    return {"format": 1, "gaps": list(DRILL_GAPS), "drills": []}


def write_drills(root, data):
    path = drills_path(root)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, indent=1, sort_keys=True) + "\n")


def drill_ratio(drill, gaps, at):
    """How overdue a Drill is relative to its gap: >= 1 means ready."""
    elapsed = (at - datetime.datetime.fromisoformat(drill["anchor"])).total_seconds() / 86400
    return elapsed / gaps[drill["gap_index"]]


def pick_drill(data, at):
    """The ready Drill most overdue relative to its gap; ties go to the older anchor."""
    ready = [d for d in data["drills"] if drill_ratio(d, data["gaps"], at) >= 1]
    if not ready:
        return None
    return sorted(ready, key=lambda d: (-drill_ratio(d, data["gaps"], at), d["anchor"]))[0]


def advance(drill, passed, gaps, at):
    drill["gap_index"] = min(drill["gap_index"] + 1, len(gaps) - 1) if passed else 0
    drill["anchor"] = at.isoformat()


def ready_at(drill, gaps):
    return datetime.datetime.fromisoformat(drill["anchor"]) + datetime.timedelta(days=gaps[drill["gap_index"]])


def active_path(root):
    return Path(root) / ".ltb" / "drill-active.json"


def active_drill(root):
    path = active_path(root)
    return json.loads(path.read_text()) if path.is_file() else None


def drill_clock(state):
    elapsed = (now() - datetime.datetime.fromisoformat(state["started"])).total_seconds()
    left = DRILL_MINUTES * 60 - elapsed
    if left <= 0:
        return "Drill %s: time is up; run ./ltb drill finish." % state["concept"]
    return "Drill %s: %d:%02d left." % (state["concept"], left // 60, left % 60)


def git(root, *args, check=True):
    proc = subprocess.run(["git"] + list(args), cwd=str(root), capture_output=True, text=True)
    if check and proc.returncode != 0:
        raise UsageError("git %s failed: %s" % (" ".join(args), (proc.stderr or proc.stdout).strip()))
    return proc.stdout.strip()


def cmd_drill(root, args):
    root = Path(root)
    data = read_drills(root)
    at = now()
    action = args.action

    if action == "add":
        if not (args.concept and args.stage and args.paths):
            raise UsageError("drill add needs --concept, --stage and --paths")
        missing = [p for p in args.paths if not (root / p).exists()]
        if missing:
            raise UsageError("no such path: %s" % ", ".join(missing))
        existing = [d for d in data["drills"] if d["concept"] == args.concept]
        if existing:
            existing[0].update(stage=args.stage.zfill(2), paths=list(args.paths))
        else:
            data["drills"].append({"concept": args.concept, "stage": args.stage.zfill(2), "paths": list(args.paths),
                                   "gap_index": 0, "anchor": at.isoformat(), "history": []})
        write_drills(root, data)
        print("Drill %s scheduled; ready from %s." % (args.concept, ready_at(existing[0] if existing else data["drills"][-1], data["gaps"]).date()))
        return OK

    if action == "list":
        if not data["drills"]:
            print("No Drills yet. They are added as Stages are reviewed.")
            return OK
        top = pick_drill(data, at)
        rows = sorted(data["drills"], key=lambda d: -drill_ratio(d, data["gaps"], at))
        for d in rows:
            ready = drill_ratio(d, data["gaps"], at) >= 1
            if args.due and not ready:
                continue
            when = "ready" if ready else "ready %s" % ready_at(d, data["gaps"]).date()
            mark = "*" if top is d else " "
            print("%s %-24s Stage %s  gap %2dd  %s" % (mark, d["concept"], d["stage"], data["gaps"][d["gap_index"]], when))
        if top:
            print("\n* suggested: ./ltb drill start %s" % top["concept"])
        return OK

    if action == "start":
        if active_drill(root):
            raise UsageError("a Drill is already running; ./ltb drill finish or ./ltb drill discard")
        drill = next((d for d in data["drills"] if d["concept"] == args.concept), None) if args.concept else pick_drill(data, at)
        if drill is None:
            raise UsageError("no such Drill" if args.concept else "no Drill is ready")
        if git(root, "status", "--porcelain", "--", "."):
            raise UsageError("commit or stash your changes first; a Drill needs a clean tree")
        origin = git(root, "rev-parse", "--abbrev-ref", "HEAD")
        if origin == "HEAD":
            raise UsageError("check out a branch first")
        branch = "drill/" + drill["concept"]
        git(root, "switch", "-q", "-c", branch)
        git(root, "rm", "-rq", "--", *drill["paths"])
        git(root, "commit", "-q", "-m", "ltb: drill %s (removed %s)" % (drill["concept"], ", ".join(drill["paths"])))
        state = {"concept": drill["concept"], "stage": drill["stage"], "origin": origin, "branch": branch,
                 "started": at.isoformat(), "green_at": None}
        active_path(root).write_text(json.dumps(state) + "\n")
        print("Drill: rebuild %s from memory (removed: %s)." % (drill["concept"], ", ".join(drill["paths"])))
        print("You have %d minutes. No notes, no AI. Check with ./ltb drill check; end with ./ltb drill finish." % DRILL_MINUTES)
        return OK

    state = active_drill(root)
    if state is None:
        raise UsageError("no Drill is running; ./ltb drill list")

    if action == "check":
        green = drill_green(root, state, verbose=True)
        if green and not state["green_at"]:
            state["green_at"] = now().isoformat()
            active_path(root).write_text(json.dumps(state) + "\n")
        print(drill_clock(state))
        return OK if green else FAILED

    if action in ("finish", "discard"):
        passed = None
        if action == "finish":
            if not state["green_at"] and drill_green(root, state, verbose=False):
                state["green_at"] = now().isoformat()
            started = datetime.datetime.fromisoformat(state["started"])
            elapsed = ((datetime.datetime.fromisoformat(state["green_at"]) if state["green_at"] else now()) - started).total_seconds()
            passed = bool(state["green_at"]) and elapsed <= DRILL_MINUTES * 60
        git(root, "reset", "-q", "--hard")
        git(root, "clean", "-fdq", "--", ".")
        git(root, "switch", "-q", state["origin"])
        git(root, "branch", "-q", "-D", state["branch"])
        active_path(root).unlink()
        if action == "discard":
            print("Drill discarded; nothing recorded. It stays ready.")
            return OK
        data = read_drills(root)
        drill = next(d for d in data["drills"] if d["concept"] == state["concept"])
        drill["history"].append({"ts": now().isoformat(), "result": "pass" if passed else "fail", "elapsed_s": int(elapsed)})
        advance(drill, passed, data["gaps"], now())
        write_drills(root, data)
        git(root, "add", "--", str(drills_path(root).relative_to(root)))
        git(root, "commit", "-q", "-m", "ltb: drill %s %s" % (state["concept"], "pass" if passed else "fail"))
        print("Drill %s: %s in %d:%02d. Next one ready %s." % (
            state["concept"], "PASS" if passed else "not this time", elapsed // 60, elapsed % 60,
            ready_at(drill, data["gaps"]).date()))
        return OK

    raise UsageError("unknown drill action %s" % action)


def drill_green(root, state, verbose):
    config = Config(Path(root) / ".ltb" / "config")
    stages = select(discover(root), state["stage"])
    ok, output = build(config)
    if not ok:
        print("Build failed: %s" % config.build)
        print("\n".join(output.rstrip().splitlines()[-15:]))
        return False
    results = [o for o in execute(config, stages, discover_hidden(root)) if o.stage != "unit"]
    if verbose:
        report(results, stages, False)
    return bool(results) and all(o.status in ("pass", "skip") for o in results)


# ---------------------------------------------------------------- status


def cmd_status(root, args):
    root = Path(root)
    config = Config(root / ".ltb" / "config")
    print("Project: build your own %s (%s; Goal: %s)" % (config.x, config.language, config.goal))
    if config.dials:
        print("Dials:   " + ", ".join("%s %s" % kv for kv in config.dials.items()))
    problems = harness_problems(root)
    print("Harness: " + ("ok" if not problems else "CHANGED (run ./ltb verify)"))
    stages = discover(root)
    run = last_run(root) or {}
    counts = run.get("stages", {})
    if not stages:
        print("Stages:  none released yet")
    for number, stage in stages.items():
        c = counts.get(number)
        state = "%d/%d passing" % tuple(c) if c else "not run yet"
        if check_file(root, number) and not check_attempted(root, number):
            state += "; Concept check unanswered (./ltb check %s)" % number
        print("Stage %s %-28s %s" % (number, stage.slug, state))
    if stages:
        latest = list(stages)[-1]
        mode = mode_for(config, latest)
        stage_dir = sorted((root / ".ltb" / "stages").glob("%s-*" % latest))
        line = "Assist:  %s for Stage %s" % (mode, latest)
        if mode == "pair" and config.pair_paths:
            line += " (agent may write: %s)" % " ".join(config.pair_paths)
        if mode == "lead" and stage_dir and not (stage_dir[0] / "approach.md").is_file():
            line += "; Approach missing: write %s before the agent codes" % (stage_dir[0] / "approach.md").relative_to(root)
        print(line)
        if stage_dir:
            print("Primer:  %s" % (stage_dir[0] / "primer.md").relative_to(root))
            if (stage_dir[0] / "skeleton.md").is_file():
                print("Skeleton: %s" % (stage_dir[0] / "skeleton.md").relative_to(root))
    open_findings = 0
    for review in sorted((root / ".ltb" / "log").glob("review-*.md")):
        open_findings += len(re.findall(r"^Status:\s*open\b", review.read_text(), re.M))
    if open_findings:
        print("Review:  %d open finding(s)" % open_findings)
    hints = read_jsonl(root / ".ltb" / "log" / "hints.jsonl")
    if stages and hints:
        latest = list(stages)[-1]
        rungs = [h["rung"] for h in hints if h.get("stage") == latest]
        if rungs:
            print("Hints:   Stage %s, %d given, highest rung %d" % (latest, len(rungs), max(rungs)))
    staged = staged_dirs(root)
    if staged:
        print("Staged:  %s (unreleased)" % ", ".join(d.name for _, _, d in staged))
    drill = active_drill(root)
    if drill:
        print("Drill:   ACTIVE. " + drill_clock(drill))
    else:
        data = read_drills(root)
        top = pick_drill(data, now())
        if top:
            print("Drill:   %s is ready (./ltb drill start %s)" % (top["concept"], top["concept"]))
        elif data["drills"]:
            soonest = min(ready_at(d, data["gaps"]) for d in data["drills"])
            print("Drill:   next ready %s" % soonest.date())
    if run:
        print("Last run: %s" % run.get("ts"))
    return OK


# ---------------------------------------------------------------- api


def cmd_api(root, args):
    print("Test files: tests/stage_NN_slug.py (public) and hidden.py (Hidden, same format; sealed into .ltb/hidden/).")
    print("Each top-level test_* function is one test; its docstring (required) is the")
    print("description the Learner sees. Plain assert works.\n")
    print("from ltb import run, serve, expect, tmpdir, skip\n")
    helpers = make_helpers(Context.__new__(Context))
    for name in ("run", "serve", "expect", "tmpdir", "skip"):
        fn = getattr(helpers, name)
        print("%s%s" % (name, inspect.signature(fn)))
        for line in inspect.getdoc(fn).splitlines():
            print("    " + line)
        print()
    return OK


# ---------------------------------------------------------------- cli


def parser():
    p = argparse.ArgumentParser(prog="ltb", description="learn-to-build Project runner")
    sub = p.add_subparsers(dest="command")
    t = sub.add_parser("test", help="build and run the Test suites")
    group = t.add_mutually_exclusive_group()
    group.add_argument("--stage", help="run only Stage NN")
    group.add_argument("--upto", help="run Stages 1..NN")
    t.add_argument("-k", help="only tests whose name contains this")
    t.add_argument("-v", "--verbose", action="store_true")
    t.add_argument("--staging", action="store_true", help="include unreleased Stages in .ltb/staging/")
    t.add_argument("--config", help="use another config (e.g. a Reference solution's); commands run in its directory")
    sub.add_parser("status", help="where the Project stands")
    sub.add_parser("verify", help="check the Harness is unchanged")
    s = sub.add_parser("seal", help="release staged Stages and record checksums (used by learn-to-build next)")
    s.add_argument("--allow-changed", nargs="*", metavar="PATH", help="Harness files deliberately edited by this release")
    c = sub.add_parser("check", help="answer a Stage's Concept check")
    c.add_argument("stage", nargs="?", help="Stage NN (default: the latest with a check)")
    c.add_argument("--question", help="answer one question by id")
    c.add_argument("--answer", help="the answer, for non-interactive use")
    lg = sub.add_parser("log", help="record a hint or a Stage's run summary (used by the agent)")
    lg.add_argument("kind", choices=["hint", "summary", "assist"])
    lg.add_argument("--paths", nargs="+")
    lg.add_argument("--stage")
    lg.add_argument("--test")
    lg.add_argument("--rung")
    lg.add_argument("--note")
    dl = sub.add_parser("dial", help="set a Dial and record why (used by the agent)")
    dl.add_argument("name")
    dl.add_argument("value")
    dl.add_argument("--evidence")
    dr = sub.add_parser("drill", help="spaced from-memory rebuilds of earlier Stages")
    dr.add_argument("action", choices=["list", "add", "start", "check", "finish", "discard"])
    dr.add_argument("concept", nargs="?")
    dr.add_argument("--due", action="store_true", help="list only ready Drills")
    dr.add_argument("--concept", dest="concept_opt")
    dr.add_argument("--stage")
    dr.add_argument("--paths", nargs="+")
    a = sub.add_parser("assist", help="show or set the Assistance mode (solo, pair, lead)")
    a.add_argument("mode", nargs="?")
    target = a.add_mutually_exclusive_group()
    target.add_argument("--stage", help="Stage NN (default: the current Stage)")
    target.add_argument("--default", action="store_true", help="set the Project default")
    a.add_argument("--paths", nargs="*", help="Pair mode: files or globs the agent may write")
    sub.add_parser("api", help="print the test-helper API")
    return p


COMMANDS = {
    "test": cmd_test, "status": cmd_status, "verify": cmd_verify, "seal": cmd_seal, "api": cmd_api,
    "check": cmd_check, "log": cmd_log, "dial": cmd_dial, "drill": cmd_drill, "assist": cmd_assist,
}


def main(argv=None, root=None):
    args = parser().parse_args(argv)
    if not args.command:
        parser().print_help()
        return USAGE
    if args.command == "drill":
        args.concept = args.concept_opt or args.concept
    sys.dont_write_bytecode = True
    root = Path(root or Path(__file__).resolve().parent)
    try:
        return COMMANDS[args.command](root, args)
    except HarnessChanged as exc:
        print(exc)
        return HARNESS_CHANGED
    except UsageError as exc:
        print("ltb: %s" % exc)
        return USAGE


if __name__ == "__main__":
    sys.exit(main())
