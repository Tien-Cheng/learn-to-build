import time
import traceback
import types
import unicodedata
from pathlib import Path

OK, FAILED, HARNESS_CHANGED, BUILD_FAILED, USAGE = 0, 1, 2, 3, 4

STAGE_FILE = re.compile(r"^stage_(\d{2})_([a-z0-9_]+)\.py$")
STAGING_DIR = re.compile(r"^(\d{2})-([a-z0-9][a-z0-9_-]*)$")
HARNESS_FIXED = ["ltb", "AGENTS.md"]
FAILURE_DETAILS = 3
HIDDEN_BANNER = (
    "# SPOILER: a Hidden test for learn-to-build. ltb runs it and shows only its description\n"
    "# when it fails. Reading it first spoils the practice; work from the Primer instead.\n\n"
)
DIALS = ("language", "domain", "design")
DRILL_GAPS = (1, 3, 7, 21)
DRILL_MINUTES = 15
MODES = ("solo", "pair", "lead")


class UsageError(Exception):
    pass


class HarnessChanged(Exception):
    pass


class TestTimeout(Exception):
    pass


class TestSkipped(Exception):
    pass


# ---------------------------------------------------------------- clock


def now():
    """Current time, overridable with LTB_NOW (ISO 8601) for tests and drills."""
    override = os.environ.get("LTB_NOW")
    if override:
        return datetime.datetime.fromisoformat(override)
    return datetime.datetime.now().astimezone().replace(microsecond=0)


def timestamp():
    return now().isoformat()


# ---------------------------------------------------------------- config


class Config:
    def __init__(self, path):
        self.path = Path(path).resolve()
        if not self.path.is_file():
            raise UsageError("no config at %s" % self.path)
        parser = configparser.ConfigParser(inline_comment_prefixes=(";", "#"))
        parser.read(self.path)
        self.parser = parser
        self.cwd = self.path.parent
        if self.path.parent.name == ".ltb":
            self.cwd = self.path.parent.parent
        self.x = parser.get("project", "x", fallback="?")
        self.goal = parser.get("project", "goal", fallback="?")
        self.language = parser.get("project", "language", fallback="?")
        self.build = parser.get("commands", "build", fallback="").strip()
        self.run = parser.get("commands", "run", fallback="").strip()
        self.unit = parser.get("commands", "unit", fallback="").strip()
        if not self.run:
            raise UsageError("%s: [commands] run is empty" % self.path)
        try:
            self.timeout = float(parser.get("commands", "timeout", fallback="10"))
        except ValueError:
            raise UsageError("%s: [commands] timeout must be a number" % self.path)
        self.assist_default = parser.get("assist", "default", fallback="solo")
        self.assist = {}
        if parser.has_section("assist"):
            for key, value in parser.items("assist"):
                if re.fullmatch(r"\d{2}", key):
                    self.assist[key] = value.strip()
        self.pair_paths = parser.get("assist", "pair_paths", fallback="").split()
        self.dials = {}
        if parser.has_section("dials"):
            for key, value in parser.items("dials"):
                self.dials[key] = value


# ---------------------------------------------------------------- program helpers (the `ltb` module tests import)


class Result:
    """Outcome of one run of the Learner's program."""

    def __init__(self, code, stdout, stderr, elapsed):
        self.code = code
        self.stdout = stdout
        self.stderr = stderr
        self.elapsed = elapsed

    def __repr__(self):
        return "Result(code=%r, stdout=%r, stderr=%r)" % (self.code, self.stdout, self.stderr)


class Context:
    """Per-test state: how to launch the program, and what it was last asked to do."""

    def __init__(self, config):
        self.config = config
        self.last_call = None
        self.tmpdirs = []
        self.servers = []

    def command(self, args, port=None):
        cmd = shlex.split(self.config.run)
        if port is not None:
            cmd = [part.replace("{port}", str(port)) for part in cmd]
        return cmd + [str(a) for a in args]

    def cleanup(self):
        for server in self.servers:
            server.stop()
        for d in self.tmpdirs:
            shutil.rmtree(d, ignore_errors=True)


class Server:
    """A running instance of the Learner's program, listening on a TCP port."""

    def __init__(self, ctx, args, ready_timeout):
        self.host = "127.0.0.1"
        self.port = _free_port()
        self._ctx = ctx
        self._out = tempfile.TemporaryFile()
        self._err = tempfile.TemporaryFile()
        env = dict(os.environ, PORT=str(self.port), LTB_PORT=str(self.port))
        cmd = ctx.command(args, port=self.port)
        ctx.last_call = {"args": list(args), "stdin": None, "port": self.port}
        try:
            self.proc = subprocess.Popen(
                cmd, cwd=str(ctx.config.cwd), env=env, stdin=subprocess.DEVNULL,
                stdout=self._out, stderr=self._err, start_new_session=True,
            )
        except OSError as exc:
            raise AssertionError("could not start %s: %s" % (cmd[0], exc))
        ctx.servers.append(self)
        deadline = time.monotonic() + ready_timeout
        while True:
            if self.proc.poll() is not None:
                raise AssertionError(
                    "server exited with code %s before accepting connections" % self.proc.returncode
                )
            try:
                socket.create_connection((self.host, self.port), timeout=0.2).close()
                return
            except OSError:
                if time.monotonic() > deadline:
                    raise TestTimeout("server did not accept connections on port %d within %ss" % (self.port, ready_timeout))
                time.sleep(0.05)

    def connect(self, timeout=None):
        """Open a new TCP connection to the server."""
        sock = socket.create_connection((self.host, self.port), timeout=timeout or self._ctx.config.timeout)
        return sock

    def request(self, data, until=b"\n", timeout=None):
        """Send bytes on a fresh connection and read until `until` appears (or the server closes)."""
        if isinstance(data, str):
            data = data.encode()
        self._ctx.last_call = {"args": None, "stdin": data, "port": self.port}
        with self.connect(timeout) as sock:
            sock.sendall(data)
            buf = b""
            try:
                while until not in buf:
                    chunk = sock.recv(65536)
                    if not chunk:
                        break
                    buf += chunk
            except socket.timeout:
                raise TestTimeout("no complete reply within %ss" % (timeout or self._ctx.config.timeout))
            return buf

    def output(self):
        """(stdout, stderr) the server has printed so far, as text."""
        return _read_tmp(self._out), _read_tmp(self._err)

    def stop(self):
        if self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGTERM)
                self.proc.wait(timeout=2)
            except (ProcessLookupError, subprocess.TimeoutExpired):
                try:
                    os.killpg(self.proc.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                self.proc.wait()

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.stop()
        return False


def _free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def _read_tmp(f):
    f.seek(0)
    return f.read().decode("utf-8", "replace")


def make_helpers(ctx):
    """Build the `ltb` module that test files import: run, serve, expect, tmpdir."""

    def run(args=(), stdin=None, timeout=None, env=None):
        """Run the Learner's program once with `args`, feeding `stdin` (str or bytes).

        Returns Result(code, stdout, stderr, elapsed); stdout/stderr are text when
        stdin is text or None, bytes when stdin is bytes.
        """
        as_text = not isinstance(stdin, bytes)
        ctx.last_call = {"args": list(args), "stdin": stdin, "port": None}
        full_env = dict(os.environ, **(env or {}))
        start = time.monotonic()
        limit = timeout or ctx.config.timeout
        try:
            proc = subprocess.run(
                ctx.command(args), cwd=str(ctx.config.cwd), input=stdin if stdin is not None else ("" if as_text else b""),
                capture_output=True, text=as_text, timeout=limit, env=full_env,
            )
        except subprocess.TimeoutExpired:
            raise TestTimeout("program did not finish within %ss" % limit)
        except OSError as exc:
            raise AssertionError("could not start the program (%s): %s" % (ctx.config.run, exc))
        return Result(proc.returncode, proc.stdout, proc.stderr, time.monotonic() - start)

    def serve(args=(), ready_timeout=5):
        """Start the Learner's program as a server; use as `with serve() as s:`.

        The run command may contain {port}; PORT and LTB_PORT are also set. Waits
        until the port accepts connections. The server is killed when the block exits.
        Server has: host, port, connect(), request(data, until=b"\\n"), output().
        """
        return Server(ctx, args, ready_timeout)

    def expect(actual, expected, label=""):
        """Assert actual == expected, failing with a readable diff."""
        if actual == expected:
            return
        head = "%s: " % label if label else ""
        if isinstance(actual, str) and isinstance(expected, str):
            diff = "\n".join(difflib.unified_diff(
                expected.splitlines(), actual.splitlines(), "expected", "actual", lineterm="",
            ))
            raise AssertionError("%soutput differs\n%s" % (head, diff or "(whitespace differs)\nexpected %r\nactual   %r" % (expected, actual)))
        raise AssertionError("%sexpected %r\n  actual %r" % (head, expected, actual))

    def skip(reason):
        """Skip this test with a reason, when the environment cannot run it (e.g. a missing oracle feature).

        A skipped test does not fail the run; use it only for environment gaps, never for behaviour.
        """
        raise TestSkipped(reason)

    def tmpdir():
        """A fresh empty directory (pathlib.Path), deleted after the test."""
        d = tempfile.mkdtemp(prefix="ltb-")
        ctx.tmpdirs.append(d)
        return Path(d)

    module = types.ModuleType("ltb")
    module.run, module.serve, module.expect, module.tmpdir, module.skip = run, serve, expect, tmpdir, skip
    module.Result = Result
    return module


# ---------------------------------------------------------------- discovery


class StageFile:
    def __init__(self, number, slug, path, source, label, hidden=False):
        self.number = number
        self.slug = slug
        self.path = path
        self.source = source
        self.label = label
        self.hidden = hidden


def discover(root, staging=False):
    """Released public Stage files (tests/stage_NN_slug.py), plus staged ones if asked. Keyed by NN."""
    stages = {}
    tests_dir = Path(root) / "tests"
    if tests_dir.is_dir():
        for path in sorted(tests_dir.iterdir()):
            m = STAGE_FILE.match(path.name)
            if m:
                stages[m.group(1)] = StageFile(m.group(1), m.group(2), path, path.read_text(), str(path.relative_to(root)))
    if staging:
        for number, slug, d in staged_dirs(root):
            public = d / "public.py"
            if public.is_file():
                stages[number] = StageFile(number, slug.replace("-", "_"), public, public.read_text(), str(public.relative_to(root)))
    return dict(sorted(stages.items()))


def discover_hidden(root, staging=False):
    """Hidden Stage files (.ltb/hidden/stage_NN_slug.py), plus staged hidden.py if asked. Keyed by NN."""
    hidden = {}
    hidden_dir = Path(root) / ".ltb" / "hidden"
    if hidden_dir.is_dir():
        for path in sorted(hidden_dir.iterdir()):
            m = STAGE_FILE.match(path.name)
            if m:
                hidden[m.group(1)] = StageFile(m.group(1), m.group(2), path, None, str(path.relative_to(root)), hidden=True)
    if staging:
        for number, slug, d in staged_dirs(root):
            path = d / "hidden.py"
            if path.is_file():
                hidden[number] = StageFile(number, slug.replace("-", "_"), path, None, str(path.relative_to(root)), hidden=True)
    return dict(sorted(hidden.items()))


def staged_dirs(root):
    base = Path(root) / ".ltb" / "staging"
    found = []
    if base.is_dir():
        for d in sorted(base.iterdir()):
            m = STAGING_DIR.match(d.name)
            if d.is_dir() and m:
                found.append((m.group(1), m.group(2), d))
            elif d.is_dir():
                raise UsageError("staging dir %s must be named NN-slug" % d.name)
    return found


def collect_tests(path, helpers):
    """Import a Stage file and return its test_* functions in definition order."""
    name = "ltb_stage_%d" % abs(hash(str(path)))
    spec = importlib.util.spec_from_file_location(name, str(path))
    module = importlib.util.module_from_spec(spec)
    saved = sys.modules.get("ltb")
    sys.modules["ltb"] = helpers
    try:
        spec.loader.exec_module(module)
    finally:
        if saved is None:
            sys.modules.pop("ltb", None)
        else:
            sys.modules["ltb"] = saved
    origin = str(Path(path))
    return [
        (n, fn) for n, fn in vars(module).items()
        if n.startswith("test_") and callable(fn) and getattr(fn, "__code__", None)
        and fn.__code__.co_filename == origin
    ]


def lint_stage_source(source, label):
    """Problems that stop a Stage file from being released."""
    problems = []
    try:
        tree = ast.parse(source, label)
    except SyntaxError as exc:
        return ["%s: syntax error: %s" % (label, exc)]
    tests = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name.startswith("test_")]
    if not tests:
        problems.append("%s: no test_* functions" % label)
    for node in tests:
        if not ast.get_docstring(node):
            problems.append("%s: %s has no docstring (it is the test's description)" % (label, node.name))
    return problems


# ---------------------------------------------------------------- concept checks


def normalize_answer(kind, answer):
    text = unicodedata.normalize("NFC", str(answer)).strip()
    if kind == "choice":
        return text.rstrip(").").strip().lower()[:1]
    if kind == "number":
        try:
            value = decimal.Decimal(text)
        except decimal.InvalidOperation:
            return text
        return format(value.normalize(), "f") if value == value.to_integral() else str(value.normalize())
    return " ".join(text.split())


def hash_answer(salt, kind, answer):
    return hashlib.sha256((salt + ":" + normalize_answer(kind, answer)).encode("utf-8")).hexdigest()


def seal_check(source):
    """Turn a staged check.src.json (plaintext answers) into check.json (salted hashes)."""
    questions = []
    for i, q in enumerate(source.get("questions", []), 1):
        kind = q.get("kind", "text")
        if kind not in ("choice", "text", "number"):
            raise UsageError("Concept check question %d: kind must be choice, text or number" % i)
        if not q.get("prompt") or not q.get("answers"):
            raise UsageError("Concept check question %d needs a prompt and answers" % i)
        salt = os.urandom(8).hex()
        sealed = {
            "id": q.get("id") or "q%d" % i, "kind": kind, "prompt": q["prompt"], "salt": salt,
            "answers": sorted({hash_answer(salt, kind, a) for a in q["answers"]}),
            "on_miss": q.get("on_miss", "the Primer"),
        }
        if q.get("choices"):
            sealed["choices"] = q["choices"]
        questions.append(sealed)
    if not 1 <= len(questions) <= 3:
        raise UsageError("a Concept check has 1 to 3 questions")
    return {"format": 1, "questions": questions}


def check_file(root, number):
    found = sorted((Path(root) / ".ltb" / "stages").glob("%s-*/check.json" % number))
    return found[0] if found else None


def check_attempted(root, number):
    return any(e.get("stage") == number for e in read_jsonl(Path(root) / ".ltb" / "log" / "checks.jsonl"))


# ---------------------------------------------------------------- running


class Outcome:
    def __init__(self, stage, name, description, status, message="", call=None, hidden=False):
        self.stage = stage
        self.name = name
        self.description = description
        self.status = status  # pass | fail | timeout | error | skip
        self.message = message
        self.call = call
        self.hidden = hidden


HIDDEN_CATEGORY = {"fail": "wrong result", "timeout": "timed out", "error": "crashed or errored"}


def run_test(stage, name, fn, ctx, hidden=False):
    description = (fn.__doc__ or "").strip().splitlines()[0] if fn.__doc__ else "(no description)"
    ctx.last_call = None
    try:
        fn()
        return Outcome(stage, name, description, "pass", hidden=hidden)
    except AssertionError as exc:
        return Outcome(stage, name, description, "fail", str(exc) or "assertion failed", ctx.last_call, hidden)
    except TestTimeout as exc:
        return Outcome(stage, name, description, "timeout", str(exc), ctx.last_call, hidden)
    except TestSkipped as exc:
        return Outcome(stage, name, description, "skip", str(exc), hidden=hidden)
    except Exception:
        tb = traceback.format_exc(limit=-3)
        return Outcome(stage, name, description, "error", tb, ctx.last_call, hidden)
    finally:
        ctx.cleanup()
        ctx.tmpdirs, ctx.servers = [], []


def build(config):
    if not config.build:
        return True, ""
    try:
        proc = subprocess.run(shlex.split(config.build), cwd=str(config.cwd), capture_output=True, text=True)
    except OSError as exc:
        return False, "could not run %s: %s" % (config.build, exc)
    return proc.returncode == 0, (proc.stdout + proc.stderr)


def select(stages, only=None, upto=None):
    if only:
        only = only.zfill(2)
        if only not in stages:
            raise UsageError("no Stage %s" % only)
        return {only: stages[only]}
    if upto:
        upto = upto.zfill(2)
        return {k: v for k, v in stages.items() if k <= upto}
    return stages


def execute(config, stages, hidden, k=None):
    """Run public then Hidden tests for each selected Stage. Returns [Outcome]."""
    ctx = Context(config)
    helpers = make_helpers(ctx)
    results = []
    for number, stage in stages.items():
        files = [stage] + ([hidden[number]] if number in hidden else [])
        for f in files:
            try:
                tests = collect_tests(f.path, helpers)
            except Exception:
                results.append(Outcome(number, "<load>", "Stage file failed to load", "error",
                                       "" if f.hidden else traceback.format_exc(limit=-2), hidden=f.hidden))
                continue
            for name, fn in tests:
                if k and k not in name:
                    continue
                results.append(run_test(number, name, fn, ctx, hidden=f.hidden))
    if config.unit:
        try:
            proc = subprocess.run(shlex.split(config.unit), cwd=str(config.cwd), capture_output=True, text=True)
            status = "pass" if proc.returncode == 0 else "fail"
            tail = "\n".join((proc.stdout + proc.stderr).rstrip().splitlines()[-20:])
        except OSError as exc:
            status, tail = "fail", "could not run %s: %s" % (config.unit, exc)
        results.append(Outcome("unit", config.unit, "Skeleton unit tests (%s)" % config.unit, status, tail))
    return results


def format_call(call):
    if not call:
        return ""
    lines = []
    if call.get("args"):
        lines.append("    args:  %s" % " ".join(shlex.quote(str(a)) for a in call["args"]))
    if call.get("stdin") not in (None, "", b""):
        text = call["stdin"]
        if isinstance(text, bytes):
            text = repr(text)
        text = text.rstrip("\n")
        text = text if len(text) < 400 else text[:400] + "..."
        lines.append("    input: " + text.replace("\n", "\n           "))
    return "\n".join(lines)


def report(results, stages, verbose, previous=None):
    """Print one line per Stage, then details of the first failures.

    A Stage is a regression when the previous run had it fully passing. Hidden
    test failures show only their description and a category, never inputs.
    """
    by_stage = {}
    for o in results:
        by_stage.setdefault(o.stage, []).append(o)
    was_green = {n for n, (p, t) in ((previous or {}).get("stages") or {}).items() if p == t and t}
    for number, outcomes in by_stage.items():
        passed = sum(o.status in ("pass", "skip") for o in outcomes)
        mark = "ok" if passed == len(outcomes) else "FAIL"
        note = "  <- regression (was green)" if mark == "FAIL" and number in was_green else ""
        hidden = sum(o.hidden for o in outcomes)
        extra = " (%d hidden)" % hidden if hidden else ""
        slug = stages[number].slug if number in stages else "Skeleton unit tests"
        label = "Stage %s" % number if number in stages else "Unit    "
        print("%s %-28s %d/%d%s %s%s" % (label, slug, passed, len(outcomes), extra, mark, note))
        if verbose:
            for o in outcomes:
                print("    %-7s %s%s" % (o.status, "[hidden] " if o.hidden else "", o.description))
    for o in results:
        if o.status == "skip":
            print("skipped: Stage %s: %s (%s)" % (o.stage, o.description, o.message))
    failures = [o for o in results if o.status not in ("pass", "skip")]
    shown = failures if verbose else failures[:FAILURE_DETAILS]
    for o in shown:
        if o.hidden:
            print("\n--- Stage %s: [hidden] %s (%s)" % (o.stage, o.description, HIDDEN_CATEGORY.get(o.status, o.status)))
            print("    Hidden test: only its description is shown. Re-read the Primer's contract for this case.")
            continue
        print("\n--- Stage %s: %s (%s)" % (o.stage, o.description, o.status))
        print("    test:  %s" % o.name)
        call = format_call(o.call)
        if call:
            print(call)
        for line in o.message.rstrip().splitlines():
            print("    " + line)
    if len(failures) > len(shown):
        print("\n(%d more failing; run with -v to see all)" % (len(failures) - len(shown)))


def stage_counts(results):
    counts = {}
    for o in results:
        c = counts.setdefault(o.stage, [0, 0])
        c[0] += o.status in ("pass", "skip")
        c[1] += 1
    return counts


def log_run(root, results, built):
    append_jsonl(Path(root) / ".ltb" / "log" / "runs.jsonl",
                 {"ts": timestamp(), "build": "ok" if built else "failed", "stages": stage_counts(results)})


def cmd_test(root, args):
    verify_or_raise(root)
    config = Config(args.config or Path(root) / ".ltb" / "config")
    stages = select(discover(root, staging=args.staging), args.stage, args.upto)
    hidden = discover_hidden(root, staging=args.staging)
    log_this = not args.config and not args.staging
    if not stages:
        print("No Stages released yet. Ask your agent for the next Stage (learn-to-build next).")
        return OK
    if log_this:
        locked = [n for n in stages if check_file(root, n) and not check_attempted(root, n)]
        for n in locked:
            print("Stage %s is locked until you answer its Concept check: ./ltb check %s" % (n, n))
            del stages[n]
        if not stages:
            return FAILED
    ok, output = build(config)
    if not ok:
        print("Build failed: %s" % config.build)
        print("\n".join(output.rstrip().splitlines()[-30:]))
        if log_this:
            log_run(root, [], False)
        return BUILD_FAILED
    results = execute(config, stages, hidden, args.k)
    report(results, stages, args.verbose, last_run(root) if log_this else None)
    if log_this:
        log_run(root, results, True)
    failing = sum(o.status not in ("pass", "skip") for o in results)
    skipped = sum(o.status == "skip" for o in results)
    print("\n%s: %d passed, %d failing%s" % ("green" if not failing else "red", len(results) - failing - skipped, failing,
                                            ", %d skipped" % skipped if skipped else ""))
    drill = active_drill(root)
    if drill and log_this:
        print(drill_clock(drill))
    return OK if not failing else FAILED


# ---------------------------------------------------------------- logs


def append_jsonl(path, entry):
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as f:
        f.write(json.dumps(entry, sort_keys=True) + "\n")


def read_jsonl(path):
    if not path.is_file():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line.strip()]


def last_run(root):
    runs = read_jsonl(Path(root) / ".ltb" / "log" / "runs.jsonl")
    return runs[-1] if runs else None


def stage_summary(root, number):
    """Runs and minutes from the first run to the first green run of one Stage."""
    runs = [r for r in read_jsonl(Path(root) / ".ltb" / "log" / "runs.jsonl") if number in r.get("stages", {})]
    summary = {"stage": number, "runs": len(runs), "minutes_to_green": None}
    if runs:
        first = datetime.datetime.fromisoformat(runs[0]["ts"])
        for r in runs:
            passed, total = r["stages"][number]
            if total and passed == total:
                summary["minutes_to_green"] = round((datetime.datetime.fromisoformat(r["ts"]) - first).total_seconds() / 60)
                break
    return summary


def cmd_log(root, args):
    log_dir = Path(root) / ".ltb" / "log"
    if args.kind == "hint":
        if not (args.stage and args.rung):
